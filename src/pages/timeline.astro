---
import Base from '../layouts/Base.astro';
import { sortedEras, sortedEntries, characters, charById, posterUrl, workBackdropUrl, isSeries, enrichText, softenText, cleanNote, pageUrl } from '../lib/data.mjs';

const entriesOf = (eraId) => sortedEntries.filter((m) => m.eraId === eraId);
const priorityMeta = {
  'must-watch': { label: '必看', en: 'MUST WATCH' },
  recommended: { label: '推荐观看', en: 'RECOMMENDED' },
  optional: { label: '可以跳过', en: 'OPTIONAL' },
};
---

<Base title="时间线 · 漫威电影世界图鉴" description="漫威电影宇宙剧情时间线：从二战到多元宇宙时代，按故事顺序排列的电影与剧集全览，每部附剧情导读与经典台词。">
  <!-- 页面大标题 -->
  <section class="tl-hero container-wide">
    <p class="tl-kicker">剧情时序 · 顺着读就懂 · TIMELINE</p>
    <h1 class="tl-page-title">漫威电影世界的时间线 <span class="en">The Marvel Timeline</span></h1>
    <p class="tl-page-desc">以下按故事发生的先后排列，从二战前一直讲到多元宇宙（the Multiverse）时代。每个篇章都有一段导读，帮你在开始前先建立大框架。</p>
  </section>

  <!-- 篇章快速跳转侧栏（sticky） -->
  <nav class="era-rail" aria-label="篇章跳转">
    <span class="era-rail__label">篇章</span>
    {sortedEras.map((era) => (
      <a class="era-rail__link" href={`#${era.id}`}>{era.name.split('（')[0]}</a>
    ))}
  </nav>

  {
    sortedEras.map((era) => {
      const eraEntries = entriesOf(era.id);
      return (
        <section
          class="era"
          id={era.id}
          style={`--era-color:${era.color};--era-soft:${era.colorSoft}`}
        >
          <!-- 篇章头图（全宽） -->
          <div class="era-hero full-bleed">
            {era.backdropUrl && <img class="era-hero__bg" src={era.backdropUrl} alt="" aria-hidden="true" />}
            <div class="era-hero__shade"></div>
            <span class="era-hero__year-bg" aria-hidden="true">{era.startYear < 0 ? '远古' : Math.abs(era.startYear)}</span>
            <div class="era-hero__inner">
              <p class="era-hero__tag">{era.name}</p>
              <h2 class="era-hero__title">{era.heroTitle}</h2>
              <p class="era-hero__years">{era.years}</p>
              <p class="era-hero__intro">{era.intro}</p>
              {era.coreGoal && (
                <div class="era-goal">
                  <span class="era-goal__index">CORE</span>
                  <div class="era-goal__body">
                    <b>本篇核心任务</b>
                    <p>{era.coreGoal}</p>
                  </div>
                </div>
              )}
            </div>
          </div>

          <!-- 篇章内条目 -->
          <div class="era-entries container-wide">
            {eraEntries.map((m, i) => (
              m.isMajorEvent ? (
                <!-- 大事件全宽特别条目 -->
                <article class="entry entry--major" id={m.id}>
                  <div class="entry--major__media">
                    <img class="entry--major__img" src={workBackdropUrl(m.id)} alt={m.title} />
                    <div class="entry--major__veil"></div>
                  </div>
                  <div class="entry--major__body">
                    <span class="entry__year">{m.yearLabel}</span>
                    {m.watchPriority && <span class={`priority-badge priority-badge--${m.watchPriority}`}>{priorityMeta[m.watchPriority]?.label || m.watchPriority}</span>}
                    {isSeries(m) && <span class="entry__series-badge">剧集 · {m.seasons}</span>}
                    <h3 class="entry__title"><a href={pageUrl(`works/${m.id}`)} set:html={softenText(m.title)}></a></h3>
                    <p class="entry__subtitle">{m.subtitle}</p>
                    {m.watchPriority && (
                      <div class={`decision decision--${m.watchPriority}`}>
                        <span class="decision__tag">
                          <span>{priorityMeta[m.watchPriority]?.label || m.watchPriority}</span>
                          <em>{priorityMeta[m.watchPriority]?.en || ''}</em>
                        </span>
                        {m.skipImpact && (
                          <p class="decision__impact">
                            <b>如果跳过</b><span set:html={enrichText(cleanNote(m.skipImpact))}></span>
                          </p>
                        )}
                      </div>
                    )}
                    <p class="entry__summary" set:html={enrichText(m.summary)}></p>
                    {m.backgroundNote && (
                      <div class="entry__know">
                        <span class="entry__know-label">观众须知 · Viewer's Guide</span>
                        <p class="entry__know-item"><b>背景</b><span set:html={enrichText(cleanNote(m.backgroundNote))}></span></p>
                        {m.relationsNote && <p class="entry__know-item"><b>人物关系</b><span set:html={enrichText(cleanNote(m.relationsNote))}></span></p>}
                        {m.timelineNote && <p class="entry__know-item"><b>时间线衔接</b><span set:html={enrichText(cleanNote(m.timelineNote))}></span></p>}
                      </div>
                    )}
                    {m.crossUniverseNote && <p class="entry__note">{m.crossUniverseNote}</p>}
                    {m.quotes && m.quotes.length > 0 && (
                      <div class="entry__quotes">
                        <span class="entry__quotes-label">经典台词 · Iconic Quotes</span>
                        {m.quotes.map((q) => (
                          <blockquote class="quote">{q}</blockquote>
                        ))}
                      </div>
                    )}
                    <div class="entry__chars">
                      {m.characters.map((cid) => <a class="char-chip" href={pageUrl(`characters/${cid}`)}>{charById[cid]?.alias || charById[cid]?.name}</a>)}
                    </div>
                  </div>
                </article>
              ) : (
                <!-- 常规条目（左右交替） -->
                <article class="entry" id={m.id} class:list={[{ 'entry--flip': i % 2 === 1 }]}>
                  <div class="entry__media">
                    <img src={posterUrl(m.id)} alt={m.title} />
                  </div>
                  <div class="entry__body">
                    <span class="entry__year">{m.yearLabel}</span>
                    {isSeries(m) && <span class="entry__series-badge">剧集 · {m.seasons}</span>}
                    <h3 class="entry__title"><a href={pageUrl(`works/${m.id}`)} set:html={softenText(m.title)}></a></h3>
                    <p class="entry__subtitle">{m.subtitle}</p>
                    {m.watchPriority && (
                      <div class={`decision decision--${m.watchPriority}`}>
                        <span class="decision__tag">
                          <span>{priorityMeta[m.watchPriority]?.label || m.watchPriority}</span>
                          <em>{priorityMeta[m.watchPriority]?.en || ''}</em>
                        </span>
                        {m.skipImpact && (
                          <p class="decision__impact">
                            <b>如果跳过</b><span set:html={enrichText(cleanNote(m.skipImpact))}></span>
                          </p>
                        )}
                      </div>
                    )}
                    <p class="entry__summary" set:html={enrichText(m.summary)}></p>
                    {m.backgroundNote && (
                      <div class="entry__know">
                        <span class="entry__know-label">观众须知 · Viewer's Guide</span>
                        <p class="entry__know-item"><b>背景</b><span set:html={enrichText(cleanNote(m.backgroundNote))}></span></p>
                        {m.relationsNote && <p class="entry__know-item"><b>人物关系</b><span set:html={enrichText(cleanNote(m.relationsNote))}></span></p>}
                        {m.timelineNote && <p class="entry__know-item"><b>时间线衔接</b><span set:html={enrichText(cleanNote(m.timelineNote))}></span></p>}
                      </div>
                    )}
                    {m.crossUniverseNote && <p class="entry__note">{m.crossUniverseNote}</p>}
                    {m.quotes && m.quotes.length > 0 && (
                      <div class="entry__quotes">
                        <span class="entry__quotes-label">经典台词 · Iconic Quotes</span>
                        {m.quotes.map((q) => (
                          <blockquote class="quote">{q}</blockquote>
                        ))}
                      </div>
                    )}
                    <div class="entry__chars">
                      {m.characters.map((cid) => <a class="char-chip" href={pageUrl(`characters/${cid}`)}>{charById[cid]?.alias || charById[cid]?.name}</a>)}
                    </div>
                  </div>
                </article>
              )
            ))}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  /* ===== 篇章快速跳转侧栏 ===== */
  .era-rail {
    position: fixed;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 10px;
    background: rgba(247, 246, 243, 0.9);
    backdrop-filter: saturate(1.4) blur(8px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .era-rail__label {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--ink-soft);
    font-weight: 600;
    text-align: center;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 4px;
  }
  .era-rail__link {
    font-size: 12px;
    color: var(--ink-soft);
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .era-rail__link:hover { color: var(--accent); background: rgba(176, 42, 30, 0.06); }

  /* ===== 锚点滚动补偿（避免被 sticky 导航遮挡） ===== */
  .era, .entry { scroll-margin-top: 88px; }

  /* ===== 页面大标题 ===== */
  .tl-hero { padding: 88px 48px 48px; }
  .tl-kicker {
    font-size: var(--fs-tiny);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
    font-weight: 600;
  }
  .tl-page-title { font-size: var(--fs-hero); line-height: 1.1; }
  .tl-page-title .en { font-size: 0.5em; letter-spacing: 2px; color: var(--ink-soft); font-weight: 600; display: block; margin-top: 10px; }
  .tl-page-desc {
    margin-top: 20px;
    color: var(--ink-soft);
    max-width: 640px;
    font-size: var(--fs-sub);
  }

  /* ===== 篇章 ===== */
  .era { margin-top: 96px; }

  /* ===== 篇章头图（全宽） ===== */
  .era-hero {
    position: relative;
    min-height: 62vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 80% 0%, var(--era-color) 0%, transparent 55%),
      linear-gradient(160deg, var(--era-color) 0%, #0e0f10 130%);
    color: #fff;
  }
  .era-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.5;
  }
  .era-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 10, 12, 0.78) 0%, rgba(10, 10, 12, 0.35) 55%, rgba(10, 10, 12, 0.15) 100%),
      linear-gradient(0deg, var(--era-color) 0%, transparent 40%);
  }
  .era-hero__inner { position: relative; z-index: 2; }
  .era-hero__year-bg {
    position: absolute;
    right: -0.03em;
    bottom: -0.22em;
    font-family: var(--font-serif);
    font-size: var(--fs-year-bg);
    font-weight: 900;
    line-height: 1;
    color: rgba(255, 255, 255, 0.14);
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
  }
  .era-hero__inner { max-width: var(--w-wide); margin: 0 auto; padding: 120px 48px; position: relative; }
  .era-hero__tag {
    display: inline-block;
    font-size: var(--fs-small);
    letter-spacing: 4px;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    padding: 6px 18px;
    margin-bottom: 24px;
  }
  .era-hero__title { font-size: clamp(36px, 5vw, 72px); max-width: 700px; }
  .era-hero__years { margin-top: 16px; font-family: var(--font-serif); font-size: var(--fs-sub); opacity: 0.85; }
  .era-hero__intro { margin-top: 24px; max-width: 620px; font-size: var(--fs-body); line-height: 2; opacity: 0.92; }

  .era-goal {
    display: flex;
    align-items: stretch;
    gap: 18px;
    margin-top: 28px;
    max-width: 720px;
    padding: 22px 24px;
    background: rgba(255, 255, 255, 0.96);
    border-left: 6px solid var(--accent);
    border-radius: 4px var(--radius) var(--radius) 4px;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    color: var(--ink);
  }
  .era-goal__index {
    flex: 0 0 auto;
    padding-right: 16px;
    border-right: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 3px;
    writing-mode: vertical-rl;
  }
  .era-goal b {
    display: block;
    margin-bottom: 7px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 3px;
  }
  .era-goal p {
    color: var(--ink);
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.65;
    font-weight: 600;
  }

  .decision {
    display: grid;
    grid-template-columns: auto 1fr;
    overflow: hidden;
    margin-bottom: 16px;
    max-width: 680px;
    border-radius: 3px var(--radius) var(--radius) 3px;
    box-shadow: 0 10px 28px rgba(15, 18, 22, 0.1);
  }
  .decision__tag {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 104px;
    padding: 11px 14px;
    color: #fff;
    text-align: center;
    background: linear-gradient(145deg, #2f333a, #575d66);
  }
  .decision__tag span {
    font-size: 19px;
    font-weight: 850;
    letter-spacing: 1px;
    line-height: 1.1;
  }
  .decision__tag em {
    margin-top: 3px;
    font-style: normal;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 2px;
    opacity: 0.72;
  }
  .decision__impact {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    color: #fff;
    background: #17181c;
    font-size: var(--fs-small);
    line-height: 1.62;
  }
  .decision__impact b {
    flex: 0 0 auto;
    padding-right: 10px;
    border-right: 1px solid rgba(255, 255, 255, 0.24);
    font-size: 12px;
    opacity: 0.66;
  }
  .decision--must-watch .decision__tag { background: linear-gradient(135deg, #c31d10 0%, #8e150c 100%); }
  .decision--must-watch .decision__impact { box-shadow: inset 4px 0 0 #c31d10; }
  .decision--recommended .decision__tag { background: linear-gradient(135deg, #d97a00 0%, #a85b00 100%); }
  .decision--recommended .decision__impact { box-shadow: inset 4px 0 0 #d97a00; }
  .decision--optional .decision__tag { background: linear-gradient(135deg, #555f57 0%, #383f39 100%); }
  .decision--optional .decision__impact { opacity: 0.82; }

  /* ===== 常规条目 ===== */
  .era-entries { display: flex; flex-direction: column; gap: 56px; padding-top: 56px; }
  .entry {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 48px;
    align-items: center;
    width: min(1080px, 100%);
  }
  .entry--flip { direction: rtl; }
  .entry--flip > * { direction: ltr; }
  .entry__media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .entry__media img { width: 100%; height: auto; display: block; }
  .entry__body { min-width: 0; }
  .entry__year {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--era-color);
    margin-bottom: 6px;
  }
  .entry__title { font-size: 34px; line-height: 1.25; margin-bottom: 2px; }
  .entry__title .c-en { font-size: 0.6em; letter-spacing: 0.5px; }
  .entry__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }
  .entry__title a:hover { color: var(--accent); }
  .entry__subtitle { color: var(--ink-soft); font-size: 19px; margin-bottom: 8px; }
  .entry__body .priority-badge { margin-left: 10px; vertical-align: middle; }
  .entry__body .watch-guide { margin-bottom: 14px; }
  .entry__summary {
    color: var(--ink);
    line-height: 1.8;
    max-width: 600px;
    margin-bottom: 14px;
    text-align: left;
    text-wrap: pretty;
    word-break: break-word;
  }
  .entry__summary .c-en { font-size: 0.8em; }
  .entry__note {
    margin-top: 14px;
    padding: 12px 16px;
    background: var(--era-soft);
    color: var(--ink-soft);
    font-size: var(--fs-small);
    line-height: 1.8;
    border-radius: var(--radius);
    border-left: 3px solid var(--era-color);
    max-width: 600px;
  }
  .entry__chars {
    margin-top: 16px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 600px;
  }
  .char-chip {
    font-size: var(--fs-small);
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
    background: #fff;
    transition: border-color 0.15s, color 0.15s;
  }
  .char-chip:hover { border-color: var(--accent); color: var(--accent); }

  /* ===== 剧集徽标 ===== */
  .entry__series-badge {
    display: inline-block;
    font-size: var(--fs-tiny);
    letter-spacing: 1px;
    font-weight: 600;
    color: #fff;
    background: var(--era-color);
    border-radius: 999px;
    padding: 3px 12px;
    margin: 0 0 10px 12px;
    vertical-align: middle;
  }

  /* ===== 观众须知 ===== */
  .entry__know {
    margin-top: 2px;
    max-width: 600px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 12px 16px;
  }
  .entry--major__body .entry__know { max-width: 720px; }
  .entry__know-label {
    display: block;
    font-size: var(--fs-tiny);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .entry__know-item {
    margin-top: 8px;
    font-size: var(--fs-small);
    line-height: 1.8;
    color: var(--ink-soft);
  }
  .entry__know-item b {
    display: block;
    color: var(--era-color);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1.5px;
    margin-bottom: 2px;
  }
  .entry__know-item:first-of-type { margin-top: 0; }
  .entry--flip .entry__know { text-align: left; }

  /* ===== 经典台词 ===== */
  .entry__quotes {
    margin-top: 16px;
    max-width: 600px;
  }
  .entry--major__body .entry__quotes { max-width: 720px; }
  .entry__quotes-label {
    display: inline-block;
    font-size: var(--fs-tiny);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .entry__quotes .quote {
    position: relative;
    margin-top: 8px;
    padding: 10px 16px 10px 38px;
    background: var(--era-soft);
    border-left: 3px solid var(--era-color);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
  }
  .entry__quotes .quote::before {
    content: "\201C";
    position: absolute;
    left: 10px;
    top: 2px;
    font-size: 30px;
    line-height: 1;
    color: var(--era-color);
    opacity: 0.55;
    font-family: Georgia, serif;
  }
  /* rtl 翻转条目里的台词边框保持朝左（内容左对齐） */
  .entry--flip .entry__quotes .quote {
    border-left: 3px solid var(--era-color);
    border-right: 0;
    text-align: left;
  }
  .entry--major__body .entry__quotes .quote { padding: 12px 20px 12px 44px; }
  .entry--major__body .entry__quotes .quote::before { left: 12px; font-size: 34px; }

  /* ===== 大事件特别条目 ===== */
  .entry--major {
    width: 100%;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .entry--major__media { position: relative; overflow: hidden; }
  .entry--major__img { width: 100%; max-height: 640px; object-fit: cover; object-position: center 30%; display: block; }
  .entry--major__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10,10,12,0.12) 0%, rgba(10,10,12,0.05) 45%, rgba(10,10,12,0.72) 100%);
    pointer-events: none;
  }
  .entry--major__body { padding: 48px 56px 56px; }
  .entry--major__body .entry__year { font-size: 28px; }
  .entry--major__body .decision { max-width: 760px; }
  .entry--major__body .entry__title { font-size: clamp(40px, 5vw, 64px); }
  .entry--major__body .entry__summary { font-size: var(--fs-sub); line-height: 1.85; max-width: 720px; }

  /* ===== 移动端 ===== */
  @media (max-width: 820px) {
    .tl-hero { padding: 56px 20px 32px; }
    .era-rail { display: none; }
    .era-hero__inner { padding: 96px 20px; }
    .era-entries { gap: 56px; padding-top: 56px; }
    .entry { grid-template-columns: 1fr; gap: 28px; width: 100%; }
    .entry--flip { direction: ltr; }
    .entry__media { order: -1; }
    .entry--major__body { padding: 32px 24px 40px; }
    .era-goal { align-items: center; gap: 14px; padding: 18px; }
    .era-goal__index { padding-right: 12px; }
    .decision { grid-template-columns: 1fr; }
    .decision__impact { align-items: flex-start; }
    .decision__impact b { padding: 0 0 4px; border-right: 0; }
  }
</style>
