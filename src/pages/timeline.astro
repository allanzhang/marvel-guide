---
import Base from '../layouts/Base.astro';
import { sortedEras, sortedEntries, characters, charById, posterUrl, workBackdropUrl, isSeries, linkConcepts, pageUrl } from '../lib/data.mjs';

const entriesOf = (eraId) => sortedEntries.filter((m) => m.eraId === eraId);
---

<Base title="时间线 · 漫威电影世界图鉴" description="漫威电影宇宙剧情时间线：从二战到多元宇宙时代，按故事顺序排列的电影与剧集全览，每部附剧情导读与经典台词。">
  <!-- 页面大标题 -->
  <section class="tl-hero container-wide">
    <p class="tl-kicker">剧情时序 · 顺着读就懂 · TIMELINE</p>
    <h1 class="tl-page-title">漫威电影世界的时间线 <span class="en">The Marvel Timeline</span></h1>
    <p class="tl-page-desc">以下按故事发生的先后排列，从二战前一直讲到多元宇宙（the Multiverse）时代。每个篇章都有一段导读，帮你在开始前先建立大框架。</p>
  </section>

  <!-- 篇章快速跳转侧栏（sticky） -->
  <nav class="era-rail" aria-label="篇章跳转">
    <span class="era-rail__label">篇章</span>
    {sortedEras.map((era) => (
      <a class="era-rail__link" href={`#${era.id}`}>{era.name.split('（')[0]}</a>
    ))}
  </nav>

  {
    sortedEras.map((era) => {
      const eraEntries = entriesOf(era.id);
      return (
        <section
          class="era"
          id={era.id}
          style={`--era-color:${era.color};--era-soft:${era.colorSoft}`}
        >
          <!-- 篇章头图（全宽） -->
          <div class="era-hero full-bleed">
            {era.backdropUrl && <img class="era-hero__bg" src={era.backdropUrl} alt="" aria-hidden="true" />}
            <div class="era-hero__shade"></div>
            <span class="era-hero__year-bg" aria-hidden="true">{era.startYear < 0 ? '远古' : Math.abs(era.startYear)}</span>
            <div class="era-hero__inner">
              <p class="era-hero__tag">{era.name}</p>
              <h2 class="era-hero__title">{era.heroTitle}</h2>
              <p class="era-hero__years">{era.years}</p>
              <p class="era-hero__intro">{era.intro}</p>
            </div>
          </div>

          <!-- 篇章内条目 -->
          <div class="era-entries container-wide">
            {eraEntries.map((m, i) => (
              m.isMajorEvent ? (
                <!-- 大事件全宽特别条目 -->
                <article class="entry entry--major" id={m.id}>
                  <div class="entry--major__media">
                    <img class="entry--major__img" src={workBackdropUrl(m.id)} alt={m.title} />
                    <div class="entry--major__veil"></div>
                  </div>
                  <div class="entry--major__body">
                    <span class="entry__year">{m.yearLabel}</span>
                    {isSeries(m) && <span class="entry__series-badge">剧集 · {m.seasons}</span>}
                    <h3 class="entry__title">{m.title}</h3>
                    <p class="entry__subtitle">{m.subtitle}</p>
                    <p class="entry__summary" set:html={linkConcepts(m.summary)}>
                    {m.quotes && m.quotes.length > 0 && (
                      <div class="entry__quotes">
                        <span class="entry__quotes-label">经典台词 · Iconic Quotes</span>
                        {m.quotes.map((q) => (
                          <blockquote class="quote">{q}</blockquote>
                        ))}
                      </div>
                    )}
                    {m.backgroundNote && (
                      <div class="entry__know">
                        <span class="entry__know-label">观众须知 · Viewer's Guide</span>
                        <p class="entry__know-item"><b>背景</b><span set:html={linkConcepts(m.backgroundNote)}></span></p>
                        {m.relationsNote && <p class="entry__know-item"><b>人物关系</b><span set:html={linkConcepts(m.relationsNote)}></span></p>}
                        {m.timelineNote && <p class="entry__know-item"><b>时间线衔接</b><span set:html={linkConcepts(m.timelineNote)}></span></p>}
                      </div>
                    )}
                    {m.crossUniverseNote && <p class="entry__note">{m.crossUniverseNote}</p>}
                    <div class="entry__chars">
                      {m.characters.map((cid) => <a class="char-chip" href={pageUrl(`characters/${cid}`)}>{charById[cid]?.alias || charById[cid]?.name}</a>)}
                    </div>
                  </div>
                </article>
              ) : (
                <!-- 常规条目（左右交替） -->
                <article class="entry" id={m.id} class:list={[{ 'entry--flip': i % 2 === 1 }]}>
                  <div class="entry__media">
                    <img src={posterUrl(m.id)} alt={m.title} />
                  </div>
                  <div class="entry__body">
                    <span class="entry__year">{m.yearLabel}</span>
                    {isSeries(m) && <span class="entry__series-badge">剧集 · {m.seasons}</span>}
                    <h3 class="entry__title">{m.title}</h3>
                    <p class="entry__subtitle">{m.subtitle}</p>
                    <p class="entry__summary" set:html={linkConcepts(m.summary)}>
                    {m.quotes && m.quotes.length > 0 && (
                      <div class="entry__quotes">
                        <span class="entry__quotes-label">经典台词 · Iconic Quotes</span>
                        {m.quotes.map((q) => (
                          <blockquote class="quote">{q}</blockquote>
                        ))}
                      </div>
                    )}
                    {m.backgroundNote && (
                      <div class="entry__know">
                        <span class="entry__know-label">观众须知 · Viewer's Guide</span>
                        <p class="entry__know-item"><b>背景</b><span set:html={linkConcepts(m.backgroundNote)}></span></p>
                        {m.relationsNote && <p class="entry__know-item"><b>人物关系</b><span set:html={linkConcepts(m.relationsNote)}></span></p>}
                        {m.timelineNote && <p class="entry__know-item"><b>时间线衔接</b><span set:html={linkConcepts(m.timelineNote)}></span></p>}
                      </div>
                    )}
                    {m.crossUniverseNote && <p class="entry__note">{m.crossUniverseNote}</p>}
                    <div class="entry__chars">
                      {m.characters.map((cid) => <a class="char-chip" href={pageUrl(`characters/${cid}`)}>{charById[cid]?.alias || charById[cid]?.name}</a>)}
                    </div>
                  </div>
                </article>
              )
            ))}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  /* ===== 篇章快速跳转侧栏 ===== */
  .era-rail {
    position: fixed;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 10px;
    background: rgba(247, 246, 243, 0.9);
    backdrop-filter: saturate(1.4) blur(8px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .era-rail__label {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--ink-soft);
    font-weight: 600;
    text-align: center;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 4px;
  }
  .era-rail__link {
    font-size: 12px;
    color: var(--ink-soft);
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .era-rail__link:hover { color: var(--accent); background: rgba(176, 42, 30, 0.06); }

  /* ===== 锚点滚动补偿（避免被 sticky 导航遮挡） ===== */
  .era, .entry { scroll-margin-top: 88px; }

  /* ===== 页面大标题 ===== */
  .tl-hero { padding: 88px 48px 48px; }
  .tl-kicker {
    font-size: var(--fs-tiny);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
    font-weight: 600;
  }
  .tl-page-title { font-size: var(--fs-hero); line-height: 1.1; }
  .tl-page-title .en { font-size: 0.5em; letter-spacing: 2px; color: var(--ink-soft); font-weight: 600; display: block; margin-top: 10px; }
  .tl-page-desc {
    margin-top: 20px;
    color: var(--ink-soft);
    max-width: 640px;
    font-size: var(--fs-sub);
  }

  /* ===== 篇章 ===== */
  .era { margin-top: 96px; }

  /* ===== 篇章头图（全宽） ===== */
  .era-hero {
    position: relative;
    min-height: 62vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 80% 0%, var(--era-color) 0%, transparent 55%),
      linear-gradient(160deg, var(--era-color) 0%, #0e0f10 130%);
    color: #fff;
  }
  .era-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.5;
  }
  .era-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 10, 12, 0.78) 0%, rgba(10, 10, 12, 0.35) 55%, rgba(10, 10, 12, 0.15) 100%),
      linear-gradient(0deg, var(--era-color) 0%, transparent 40%);
  }
  .era-hero__inner { position: relative; z-index: 2; }
  .era-hero__year-bg {
    position: absolute;
    right: -0.03em;
    bottom: -0.22em;
    font-family: var(--font-serif);
    font-size: var(--fs-year-bg);
    font-weight: 900;
    line-height: 1;
    color: rgba(255, 255, 255, 0.14);
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
  }
  .era-hero__inner { max-width: var(--w-wide); margin: 0 auto; padding: 120px 48px; position: relative; }
  .era-hero__tag {
    display: inline-block;
    font-size: var(--fs-small);
    letter-spacing: 4px;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    padding: 6px 18px;
    margin-bottom: 24px;
  }
  .era-hero__title { font-size: clamp(36px, 5vw, 72px); max-width: 700px; }
  .era-hero__years { margin-top: 16px; font-family: var(--font-serif); font-size: var(--fs-sub); opacity: 0.85; }
  .era-hero__intro { margin-top: 24px; max-width: 620px; font-size: var(--fs-body); line-height: 2; opacity: 0.92; }

  /* ===== 常规条目 ===== */
  .era-entries { display: flex; flex-direction: column; gap: 88px; padding-top: 88px; }
  .entry {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 64px;
    align-items: center;
    width: min(1080px, 100%);
  }
  .entry--flip { direction: rtl; }
  .entry--flip > * { direction: ltr; }
  .entry__media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .entry__media img { width: 100%; height: auto; display: block; }
  .entry__body { min-width: 0; }
  .entry__year {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: var(--fs-section);
    font-weight: 700;
    color: var(--era-color);
    margin-bottom: 10px;
  }
  .entry__title { font-size: var(--fs-title); margin-bottom: 4px; }
  .entry__subtitle { color: var(--ink-soft); font-size: var(--fs-sub); margin-bottom: 20px; }
  .entry__summary { color: var(--ink); line-height: 1.95; max-width: 600px; }
  .entry__note {
    margin-top: 28px;
    padding: 16px 20px;
    background: var(--era-soft);
    color: var(--ink-soft);
    font-size: var(--fs-small);
    line-height: 1.9;
    border-radius: var(--radius);
    border-left: 3px solid var(--era-color);
    max-width: 600px;
  }
  .entry__chars {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 600px;
  }
  .char-chip {
    font-size: var(--fs-small);
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
    background: #fff;
    transition: border-color 0.15s, color 0.15s;
  }
  .char-chip:hover { border-color: var(--accent); color: var(--accent); }

  /* ===== 剧集徽标 ===== */
  .entry__series-badge {
    display: inline-block;
    font-size: var(--fs-tiny);
    letter-spacing: 1px;
    font-weight: 600;
    color: #fff;
    background: var(--era-color);
    border-radius: 999px;
    padding: 3px 12px;
    margin: 0 0 10px 12px;
    vertical-align: middle;
  }

  /* ===== 观众须知 ===== */
  .entry__know {
    margin-top: 28px;
    max-width: 600px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 20px 22px;
  }
  .entry--major__body .entry__know { max-width: 720px; }
  .entry__know-label {
    display: block;
    font-size: var(--fs-tiny);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .entry__know-item {
    margin-top: 10px;
    font-size: var(--fs-small);
    line-height: 1.9;
    color: var(--ink-soft);
  }
  .entry__know-item b {
    display: inline-block;
    color: var(--era-color);
    margin-right: 8px;
    font-weight: 600;
  }
  .entry__know-item:first-of-type { margin-top: 0; }
  .entry--flip .entry__know { text-align: left; }

  /* ===== 经典台词 ===== */
  .entry__quotes {
    margin-top: 28px;
    max-width: 600px;
  }
  .entry--major__body .entry__quotes { max-width: 720px; }
  .entry__quotes-label {
    display: inline-block;
    font-size: var(--fs-tiny);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 600;
    margin-bottom: 14px;
  }
  .entry__quotes .quote {
    position: relative;
    margin-top: 14px;
    padding: 18px 22px 18px 48px;
    background: var(--era-soft);
    border-left: 3px solid var(--era-color);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-sub);
    line-height: 1.9;
    color: var(--ink);
  }
  .entry__quotes .quote::before {
    content: "\201C";
    position: absolute;
    left: 14px;
    top: 4px;
    font-size: 44px;
    line-height: 1;
    color: var(--era-color);
    opacity: 0.55;
    font-family: Georgia, serif;
  }
  /* rtl 翻转条目里的台词边框保持朝左（内容左对齐） */
  .entry--flip .entry__quotes .quote {
    border-left: 3px solid var(--era-color);
    border-right: 0;
    text-align: left;
  }
  .entry--major__body .entry__quotes .quote { padding: 22px 28px 22px 60px; }
  .entry--major__body .entry__quotes .quote::before { left: 18px; font-size: 56px; }

  /* ===== 大事件特别条目 ===== */
  .entry--major {
    width: 100%;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .entry--major__media { position: relative; overflow: hidden; }
  .entry--major__img { width: 100%; max-height: 640px; object-fit: cover; object-position: center 30%; display: block; }
  .entry--major__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10,10,12,0.12) 0%, rgba(10,10,12,0.05) 45%, rgba(10,10,12,0.72) 100%);
    pointer-events: none;
  }
  .entry--major__body { padding: 56px 64px 64px; }
  .entry--major__body .entry__year { font-size: var(--fs-title); }
  .entry--major__body .entry__title { font-size: clamp(40px, 5vw, 64px); }
  .entry--major__body .entry__summary { font-size: var(--fs-sub); line-height: 2; }

  /* ===== 移动端 ===== */
  @media (max-width: 820px) {
    .tl-hero { padding: 56px 20px 32px; }
    .era-rail { display: none; }
    .era-hero__inner { padding: 96px 20px; }
    .era-entries { gap: 56px; padding-top: 56px; }
    .entry { grid-template-columns: 1fr; gap: 28px; width: 100%; }
    .entry--flip { direction: ltr; }
    .entry__media { order: -1; }
    .entry--major__body { padding: 32px 24px 40px; }
  }
</style>
