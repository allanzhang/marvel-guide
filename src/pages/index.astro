---
import Base from '../layouts/Base.astro';
const BASE = import.meta.env.BASE_URL || '/';
---
<Base title="漫威电影世界图鉴" description="面向看过大部分 MCU 但剧情还没串起来的读者：用主线复盘、时间线、人物和概念，把漫威电影世界的因果关系重新接起来。">
  <!-- 全屏 hero -->
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__kicker">主线复盘 · 时间线 · 人物与概念索引</p>
      <h1 class="hero__title">把看过的漫威<br />重新串起来</h1>
      <p class="hero__desc">Marvel 电影世界（Marvel Cinematic Universe）几十部电影和剧集，人物、事件、宝石、多元宇宙交织在一起。这里不替你逐场复述，而是把散落在作品里的因果关系接成一条清晰主线。</p>
      <div class="hero__actions">
        <a class="hero__cta hero__cta--primary" href={`${BASE}recap`}>开始主线复盘 →</a>
        <a class="hero__cta" href={`${BASE}timeline`}>查看时间线</a>
      </div>
    </div>
  </section>

  <!-- 六入口 -->
  <section class="entries container-wide">
    <a class="entry-card entry-card--primary" href={`${BASE}recap`}>
      <span class="entry-card__badge">核心入口</span>
      <span class="entry-card__num">01</span>
      <h2 class="entry-card__title">主线复盘 <span class="en">Story Recap</span></h2>
      <p class="entry-card__desc">按五大篇章和 24 个跨作品大事件，梳理关键转折、人物变化、概念伏笔和作品之间的因果链。</p>
      <span class="entry-card__go">开始复盘 →</span>
    </a>
    <a class="entry-card" href={`${BASE}timeline`}>
      <span class="entry-card__num">02</span>
      <h2 class="entry-card__title">时间线 <span class="en">Timeline</span></h2>
      <p class="entry-card__desc">按故事发生的先后，从二战一路讲到多元宇宙（the Multiverse）。每段都有导读，快速定位作品位置。</p>
      <span class="entry-card__go">定位作品 →</span>
    </a>
    <a class="entry-card" href={`${BASE}works`}>
      <span class="entry-card__num">03</span>
      <h2 class="entry-card__title">作品图鉴 <span class="en">All Works</span></h2>
      <p class="entry-card__desc">浏览全部 56 部电影和剧集的海报、完整剧情、剧照、影评、主线定位和片后状态。</p>
      <span class="entry-card__go">浏览作品 →</span>
    </a>
    <a class="entry-card" href={`${BASE}characters`}>
      <span class="entry-card__num">04</span>
      <h2 class="entry-card__title">人物墙 <span class="en">Characters</span></h2>
      <p class="entry-card__desc">从复仇者（the Avengers）核心到反派堂，查每个人物是谁、起什么作用、角色弧线和关系变化。</p>
      <span class="entry-card__go">认识人物 →</span>
    </a>
    <a class="entry-card" href={`${BASE}concepts`}>
      <span class="entry-card__num">05</span>
      <h2 class="entry-card__title">概念库 <span class="en">Concepts</span></h2>
      <p class="entry-card__desc">无限宝石、魔法体系、神秘组织与重要事件——忘记设定时，回到这里快速补齐剧情作用和当前状态。</p>
      <span class="entry-card__go">查词条 →</span>
    </a>
    <a class="entry-card" href={`${BASE}faq`}>
      <span class="entry-card__num">06</span>
      <h2 class="entry-card__title">常见疑问 <span class="en">MCU FAQ</span></h2>
      <p class="entry-card__desc">时间穿越、多元宇宙、响指、人物去向和未上映走向——15 个最容易混淆的问题一次讲清。</p>
      <span class="entry-card__go">查看 FAQ →</span>
    </a>
  </section>

  <!-- 复盘路径指引 -->
  <section class="guide container-text">
    <h2 class="guide__title">想把剧情串起来？从这里开始</h2>
    <ol class="guide__steps">
      <li>
        <span class="guide__step-num">01</span>
        <div>
          <h3>先读主线复盘</h3>
          <p>从宇宙魔方、复仇者集结，到响指和多元宇宙失控，先建立跨作品的大事件骨架。</p>
        </div>
      </li>
      <li>
        <span class="guide__step-num">02</span>
        <div>
          <h3>用时间线定位具体作品</h3>
          <p>想不起某部片发生在哪个阶段时，回到时间线查看它的剧情位置、观看优先级和跳过影响。</p>
        </div>
      </li>
      <li>
        <span class="guide__step-num">03</span>
        <div>
          <h3>点人物和概念查漏补缺</h3>
          <p>忘记谁做过什么、某个组织或宝石有什么作用时，直接进入人物墙和概念库补齐记忆。</p>
        </div>
      </li>
    </ol>
  </section>
</Base>

<style>
  /* ===== Hero ===== */
  .hero {
    min-height: 78vh;
    display: flex;
    align-items: center;
    position: relative;
    background:
      radial-gradient(90% 80% at 85% 10%, rgba(176, 42, 30, 0.28) 0%, transparent 55%),
      linear-gradient(160deg, #121316 0%, #1b1c1f 60%, #20212a 100%);
    color: #fff;
    overflow: hidden;
  }
  .hero__inner { max-width: var(--w-wide); margin: 0 auto; padding: 120px 48px; width: 100%; }
  .hero__kicker {
    font-size: var(--fs-small);
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 28px;
  }
  .hero__title {
    font-size: clamp(52px, 9vw, 120px);
    line-height: 1.05;
    font-weight: 900;
  }
  .hero__desc {
    margin-top: 32px;
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.9;
    color: rgba(255,255,255,0.85);
    max-width: 720px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.28);
    color: rgba(255,255,255,0.9);
    font-weight: 700;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .hero__cta:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.58);
    color: #fff;
  }
  .hero__cta--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .hero__cta--primary:hover {
    background: #c53427;
    border-color: #c53427;
  }

  /* ===== 四入口 ===== */
  .entries { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding: 96px 48px 0; }
  .entry-card {
    border-radius: var(--radius);
    padding: 32px 26px 30px;
    background: #fff;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    display: flex;
    flex-direction: column;
  }
  .entry-card:hover { transform: translateY(-4px); box-shadow: 0 12px 34px rgba(0,0,0,0.12); }
  .entry-card--primary {
    border-color: rgba(176, 42, 30, 0.34);
    background: linear-gradient(180deg, #fff 0%, #fff8f6 100%);
  }
  .entry-card__badge {
    align-self: flex-start;
    margin-bottom: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(176, 42, 30, 0.1);
    color: var(--accent);
    font-size: var(--fs-tiny);
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .entry-card__num { font-family: var(--font-serif); font-size: var(--fs-small); color: var(--accent); font-weight: 700; }
    .entry-card__title { font-size: 28px; margin: 12px 0 10px; }
  .entry-card__title .en { font-size: 0.55em; font-weight: 600; letter-spacing: 1px; color: var(--ink-soft); display: block; margin-top: 4px; }
  .entry-card__desc { color: var(--ink-soft); line-height: 1.9; flex: 1; }
  .entry-card__go { margin-top: 28px; font-weight: 600; color: var(--accent); }

  /* ===== 复盘路径指引 ===== */
  .guide { padding-top: 110px; }
  .guide__title { font-size: var(--fs-section); margin-bottom: 40px; }
  .guide__steps { display: flex; flex-direction: column; gap: 40px; }
  .guide__steps li { display: flex; gap: 28px; align-items: flex-start; }
  .guide__step-num { font-family: var(--font-serif); font-size: var(--fs-title); color: var(--line); font-weight: 700; flex-shrink: 0; }
  .guide__steps h3 { font-family: var(--font-serif); font-size: var(--fs-sub); margin-bottom: 6px; }
  .guide__steps p { color: var(--ink-soft); }

  @media (max-width: 1100px) {
    .entries { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .hero__inner { padding: 96px 20px; }
    .entries { grid-template-columns: 1fr; padding: 64px 20px 0; }
    .guide { padding-top: 80px; padding-left: 20px; padding-right: 20px; }
    .entry-card__title { font-size: 30px; }
  }
</style>
