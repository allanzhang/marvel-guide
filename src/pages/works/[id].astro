---
import Base from '../../layouts/Base.astro';
import { sortedEntries, characters, charById, conceptById, eraById, posterUrl, portraitUrl, workBackdropUrl, isSeries, enrichText, softenText, cleanNote, pageUrl } from '../../lib/data.mjs';

export async function getStaticPaths() {
  const { sortedEntries } = await import('../../lib/data.mjs');
  return sortedEntries.map((w) => ({ params: { id: w.id }, props: { w } }));
}

const { w } = Astro.props;
const era = eraById[w.eraId] || {};
const eraColor = era.color || 'var(--accent)';
const eraSoft = era.colorSoft || '#f5e6e3';
const heroSrc = w.stills?.[0] ? pageUrl(w.stills[0]) : posterUrl(w.id);
const priorityMeta = {
  'must-watch': { label: '必看', en: 'MUST WATCH' },
  recommended: { label: '推荐观看', en: 'RECOMMENDED' },
  optional: { label: '可以跳过', en: 'OPTIONAL' },
};
const wCharacters = (w.characters || []).map((cid) => charById[cid]).filter(Boolean);
const idx = sortedEntries.findIndex((x) => x.id === w.id);
const prev = sortedEntries[idx - 1];
const next = sortedEntries[idx + 1];
const cleanReviews = (w.reviews || []).filter((r) => {
  const t = String(r.content).trim();
  return !/^(full spoiler|spoiler(?!:)|check out|https?:|review @|★)/i.test(t);
});
const sortedReviews = [...cleanReviews]
  .sort((a, b) => (a.lang === 'zh' ? 0 : 1) - (b.lang === 'zh' ? 0 : 1))
  .slice(0, 4);
const excerpt = (text) => {
  const t = String(text).replace(/\s+/g, ' ').trim();
  const sentences = t.match(/[^.!?。！？]*[.!?。！？]+/g) || [t];
  let out = '';
  for (const s of sentences) {
    out += s;
    if (out.trim().length >= 40) break;
  }
  out = out.trim();
  return out.length > 60 ? `${out.slice(0, 58)}…` : out;
};
const storyStates = (w.aftermath?.characterStates || []).map((state) => ({
  ...state,
  name: charById[state.id]?.alias || charById[state.id]?.name || state.id,
}));
---

<Base title={`${w.title} · 漫威电影世界图鉴`} description={`${w.title}：${(w.summary || '').slice(0, 120)}…`}>
  <article class="work-detail">
    <!-- 全宽头图 -->
    <section class="wd-hero full-bleed">
      <img class="wd-hero__bg" src={heroSrc} alt="" aria-hidden="true" />
      <div class="wd-hero__shade"></div>
      <div class="wd-hero__inner">
        <p class="wd-hero__year">{w.yearLabel}</p>
        <h1 class="wd-hero__title" set:html={softenText(w.title)}></h1>
        <p class="wd-hero__subtitle">{w.subtitle}</p>
        {w.watchPriority && (
          <div class={`decision decision--${w.watchPriority} wd-decision`}>
            <span class="decision__tag">
              <span>{priorityMeta[w.watchPriority]?.label || w.watchPriority}</span>
              <em>{priorityMeta[w.watchPriority]?.en || ''}</em>
            </span>
            {w.skipImpact && (
              <p class="decision__impact"><b>如果跳过</b><span set:html={enrichText(cleanNote(w.skipImpact))}></span></p>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- 正文 -->
    <div class="wd-body">
      <section class="wd-section">
        <h2>剧情导读</h2>
        <p set:html={enrichText(w.summary)}></p>
        {w.overview && (
          <div class="wd-overview">
            <b>完整剧情</b>
            <p set:html={enrichText(w.overview)}></p>
          </div>
        )}
      </section>

      {w.storyRole && (
        <section class="wd-story-role">
          <div class="wd-story-role__head">
            <span class="wd-story-role__kicker">STORY POSITION</span>
            <h2>在主线中的位置</h2>
          </div>
          <p class="wd-story-role__text" set:html={enrichText(w.storyRole)}></p>

          {w.keyTakeaways?.length > 0 && (
            <div class="wd-takeaways">
              <h3>看完只记这几件事</h3>
              <ul>
                {w.keyTakeaways.map((item) => <li set:html={enrichText(item)}></li>)}
              </ul>
            </div>
          )}

          {w.aftermath && (
            <div class="wd-aftermath">
              <h3>伏笔与片后状态</h3>
              <div class="wd-aftermath__grid">
                {w.aftermath.setup?.length > 0 && (
                  <div>
                    <b>埋下</b>
                    <ul>{w.aftermath.setup.map((item) => <li set:html={enrichText(item)}></li>)}</ul>
                  </div>
                )}
                {w.aftermath.payoff?.length > 0 && (
                  <div>
                    <b>回收</b>
                    <ul>{w.aftermath.payoff.map((item) => <li set:html={enrichText(item)}></li>)}</ul>
                  </div>
                )}
              </div>
              {storyStates.length > 0 && (
                <div class="wd-states">
                  <b>本片之后</b>
                  <div class="wd-states__grid">
                    {storyStates.map((state) => (
                      <div class="wd-state">
                        <a class="wd-state__name" href={pageUrl(`characters/${state.id}`)} set:html={softenText(state.name)}></a>
                        <span class="wd-state__text" set:html={enrichText(state.state)}></span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}
        </section>
      )}

      {(w.backgroundNote || w.relationsNote || w.timelineNote) && (
        <section class="wd-section">
          <h2>观众须知</h2>
          {w.backgroundNote && <div><b>背景</b><p set:html={enrichText(cleanNote(w.backgroundNote))}></p></div>}
          {w.relationsNote && <div><b>人物关系</b><p set:html={enrichText(cleanNote(w.relationsNote))}></p></div>}
          {w.timelineNote && <div><b>时间线衔接</b><p set:html={enrichText(cleanNote(w.timelineNote))}></p></div>}
        </section>
      )}

      {w.crossUniverseNote && (
        <section class="wd-section">
          <h2>跨宇宙注解</h2>
          <p>{w.crossUniverseNote}</p>
        </section>
      )}
    </div>

    <!-- 剧照 -->
    {w.stills?.length > 0 && (
      <section class="wd-stills full-bleed">
        <div class="container-wide">
          <h2 class="wd-stills__title">剧照</h2>
          <div class:list={['wd-stills__grid', `wd-stills__grid--${w.stills.length}`]}>
            {w.stills.map((src) => <img src={pageUrl(src)} alt={`${w.title} 剧照`} loading="lazy" />)}
          </div>
        </div>
      </section>
    )}

    <!-- 出场人物 -->
    {wCharacters.length > 0 && (
      <section class="wd-cast">
        <div class="container-wide">
          <h2 class="wd-cast__title">出场人物</h2>
          <div class="wd-cast__grid">
            {wCharacters.map((c) => (
              <a class="cast" href={pageUrl(`characters/${c.id}`)}>
                <img src={portraitUrl(c.id)} alt={c.name} loading="lazy" />
                <span>{charById[c.id]?.alias || c.name}</span>
              </a>
            ))}
            </div>
        </div>
      </section>
    )}

    <!-- 经典台词 -->
    {w.quotes?.length > 0 && (
      <section class="wd-quotes" style={`--era-color:${eraColor};--era-soft:${eraSoft}`}>
        <div class="wd-quotes__inner">
          <span class="wd-quotes__label">经典台词 · Iconic Quotes</span>
          {w.quotes.map((q) => <blockquote class="wd-quotes__quote">{q}</blockquote>)}
        </div>
      </section>
    )}

    <!-- 影评 -->
    {sortedReviews.length > 0 && (
      <section class="wd-reviews">
        <div class="wd-reviews__inner">
          <h2>精选影评</h2>
          {sortedReviews.map((r) => (
            <blockquote class="wd-review">
              <p>{excerpt(r.content)}</p>
              <footer>
                <span class={`wd-review__lang${r.lang === 'zh' ? ' wd-review__lang--zh' : ''}`}>
                  {r.lang === 'zh' ? '中文影评' : '外媒短评'}
                </span>
                — {r.author}{r.rating && <span class="wd-review__rating"> ★ {r.rating}</span>}
              </footer>
            </blockquote>
          ))}
        </div>
      </section>
    )}

    <!-- 底部导航 -->
    <nav class="wd-nav container-wide">
      {prev ? <a href={pageUrl(`works/${prev.id}`)}>← {prev.title.split('（')[0]}</a> : <span></span>}
      <a href={pageUrl(`timeline#${w.id}`)}>← 返回时间线</a>
      {next ? <a href={pageUrl(`works/${next.id}`)}>{next.title.split('（')[0]} →</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
/* ===== 头图 ===== */
.wd-hero{position:relative;min-height:66vh;display:flex;align-items:flex-end;overflow:hidden;background:#0e0f11;color:#fff}
.wd-hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%;opacity:1}
.wd-hero__shade{position:absolute;inset:0;background:
  linear-gradient(90deg,rgba(8,8,10,.84) 0%,rgba(8,8,10,.5) 42%,rgba(8,8,10,.18) 68%,rgba(8,8,10,.5) 100%),
  linear-gradient(0deg,#0b0b0d 0%,rgba(11,11,13,.5) 40%,transparent 78%)}
.wd-hero__inner{position:relative;z-index:1;width:min(1160px,100%);margin:0 auto;padding:96px 48px 88px}
.wd-hero__year{font-family:var(--font-serif);font-size:24px;letter-spacing:1px;opacity:.9;margin-bottom:12px}
.wd-hero__title{font-size:clamp(46px,6vw,86px);line-height:1.08;max-width:900px;text-shadow:0 4px 30px rgba(0,0,0,.5)}
.wd-hero__subtitle{margin-top:16px;color:rgba(255,255,255,.85);font-size:22px}
.wd-decision{margin-top:32px;max-width:760px}

/* ===== 正文 ===== */
.wd-body{padding:56px 48px 72px;display:flex;flex-direction:column;gap:48px;max-width:1120px;margin:0 auto}
.wd-section h2{font-size:26px;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--line);letter-spacing:1px}
.wd-section p{
  font-family:var(--font-serif);
  font-size:18px;
  line-height:2;
  color:var(--ink);
  max-width:820px;
  text-align:left;
  text-wrap:pretty;
}
.wd-section b{display:block;margin-bottom:6px;color:var(--accent);font-size:13px;font-weight:700}
.wd-overview{margin-top:28px;padding-top:24px;border-top:1px solid var(--line)}
.wd-overview b{display:block;margin-bottom:10px}

.wd-stills{padding:72px 48px 80px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#0c0d10;color:#fff}
.wd-stills__title{font-size:32px;margin-bottom:36px;text-align:center;letter-spacing:1px}
.wd-stills__grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:280px;gap:18px;max-width:1440px;margin:0 auto}
.wd-stills__grid img{width:100%;height:100%;object-fit:cover;border-radius:10px;box-shadow:0 16px 48px rgba(0,0,0,.55);transition:transform .3s,box-shadow .3s}
.wd-stills__grid img:hover{transform:scale(1.02);box-shadow:0 24px 64px rgba(0,0,0,.75)}
/* 4 张：左大竖图 + 右上双小图 + 右下横图 */
.wd-stills__grid--4 img:nth-child(1){grid-column:1/3;grid-row:1/3}
.wd-stills__grid--4 img:nth-child(2){grid-column:3/4;grid-row:1/2}
.wd-stills__grid--4 img:nth-child(3){grid-column:4/5;grid-row:1/2}
.wd-stills__grid--4 img:nth-child(4){grid-column:3/5;grid-row:2/3}
/* 3 张：左大图 + 右侧两张竖排 */
.wd-stills__grid--3 img:nth-child(1){grid-column:1/3;grid-row:1/3}
.wd-stills__grid--3 img:nth-child(2){grid-column:3/5;grid-row:1/2}
.wd-stills__grid--3 img:nth-child(3){grid-column:3/5;grid-row:2/3}
/* 2 张：并排大图 */
.wd-stills__grid--2{grid-auto-rows:360px}
.wd-stills__grid--2 img:nth-child(1){grid-column:1/3;grid-row:1/2}
.wd-stills__grid--2 img:nth-child(2){grid-column:3/5;grid-row:1/2}

.wd-reviews{padding:48px 48px 56px;border-top:1px solid var(--line);background:#faf9f6}
.wd-reviews__inner{max-width:1160px;margin:0 auto}
.wd-reviews h2{font-size:26px;margin-bottom:20px}
.wd-review{
  margin-bottom:20px;padding:22px 26px;background:#fff;
  border-left:4px solid var(--accent);border-radius:var(--radius);
  box-shadow:0 4px 18px rgba(15,18,22,.07);max-width:1000px;
}
.wd-review p{
  font-family:var(--font-serif);font-size:17px;line-height:1.9;
  color:var(--ink);margin-bottom:12px;text-wrap:pretty;
}
.wd-review footer{display:flex;align-items:center;gap:10px;color:var(--ink-soft);font-size:13px}
.wd-review__lang{
  display:inline-block;padding:3px 10px;border-radius:999px;
  border:1px solid var(--line);color:var(--ink-soft);font-size:12px;white-space:nowrap;
}
.wd-review__lang--zh{color:#b02a1e;border-color:#b02a1e;background:rgba(176,42,30,.06)}
.wd-review__rating{color:#d97a00;font-weight:700}

/* ===== 人物 ===== */
.wd-cast{padding:48px 48px 56px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#faf9f6}
.wd-cast__title{font-size:26px;margin-bottom:24px}
.wd-cast__grid{display:flex;flex-wrap:wrap;gap:22px}

/* ===== 台词（复用时间线风格） ===== */
.wd-quotes{padding:56px 48px 64px;background:var(--era-soft,#faf9f6)}
.wd-quotes__inner{max-width:820px;margin:0 auto}
.wd-quotes__label{
  display:inline-block;font-size:var(--fs-tiny);letter-spacing:2px;text-transform:uppercase;
  color:var(--ink-soft);font-weight:600;margin-bottom:14px
}
.wd-quotes__quote{
  position:relative;margin-top:12px;padding:14px 20px 14px 52px;
  background:#fff;border-left:3px solid var(--era-color,var(--accent));
  border-radius:0 var(--radius) var(--radius) 0;
  font-family:var(--font-serif);font-style:italic;font-size:clamp(18px,1.6vw,22px);
  line-height:1.65;color:var(--ink);box-shadow:0 2px 12px rgba(0,0,0,.05)
}
.wd-quotes__quote::before{
  content:"\201C";position:absolute;left:14px;top:4px;
  font-size:38px;line-height:1;color:var(--era-color,var(--accent));opacity:.5;
  font-family:Georgia,serif
}

/* ===== 底部导航 ===== */
.wd-nav{display:flex;justify-content:space-between;gap:16px;padding:40px 48px 72px;font-size:15px}
.wd-nav a{color:var(--ink-soft);text-decoration:none;white-space:nowrap}
.wd-nav a:hover{color:var(--accent)}

@media (max-width:820px){
  .wd-hero__inner{padding:80px 20px 64px}
  .wd-hero__title{font-size:clamp(34px,9vw,46px)}
  .wd-body,.wd-cast,.wd-quotes,.wd-nav{padding-left:20px;padding-right:20px}
  .wd-stills,.wd-reviews{padding-left:20px;padding-right:20px}
  .wd-body{padding-top:48px;padding-bottom:48px;gap:44px}
  .wd-stills__grid{grid-template-columns:1fr 1fr;grid-auto-rows:140px}
  .wd-stills__grid img:nth-child(n){grid-column:auto;grid-row:auto}
  .wd-stills__grid--2{grid-auto-rows:180px}
  .wd-cast{padding-top:44px;padding-bottom:44px}
  .wd-quotes{padding-top:44px;padding-bottom:44px}
  .wd-nav{flex-wrap:wrap;padding-top:32px;padding-bottom:52px;font-size:14px}
}
  /* ===== 主线定位 ===== */
  .wd-story-role{
    margin:56px 0;padding:34px 36px;border-radius:var(--radius);
    background:linear-gradient(180deg,#fff 0%,#fbf7f5 100%);
    border:1px solid var(--line);border-left:5px solid var(--era-color,var(--accent));
    box-shadow:var(--shadow)
  }
  .wd-story-role__kicker{color:var(--accent);font-size:var(--fs-tiny);letter-spacing:.18em;font-weight:700}
  .wd-story-role h2{font-size:30px;margin:8px 0 16px}
  .wd-story-role__text{font-size:18px;line-height:2;color:var(--ink);max-width:900px}
  .wd-takeaways,.wd-aftermath{margin-top:28px}
  .wd-takeaways h3,.wd-aftermath h3{font-family:var(--font-sans);font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:14px}
  .wd-takeaways ul,.wd-aftermath ul{display:grid;gap:10px;list-style:none}
  .wd-takeaways li{position:relative;padding-left:22px;line-height:1.85}
  .wd-takeaways li::before{content:'';position:absolute;left:0;top:.82em;width:7px;height:7px;border-radius:50%;background:var(--era-color,var(--accent))}
  .wd-aftermath__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
  .wd-aftermath b{display:block;margin-bottom:8px}
  .wd-aftermath li{padding-left:18px;position:relative;color:var(--ink-soft);line-height:1.8}
  .wd-aftermath li::before{content:'';position:absolute;left:0;top:.75em;width:6px;height:6px;border-radius:50%;background:var(--line)}
  .wd-states{margin-top:22px}
  .wd-states__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-top:12px}
  .wd-state{display:block;padding:16px 18px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;transition:border-color .15s,transform .15s}
  .wd-state:hover{border-color:rgba(176,42,30,.45);transform:translateY(-2px)}
  .wd-state__name{display:block;font-weight:700;margin-bottom:6px;color:var(--ink);text-decoration:none}
  .wd-state__name:hover{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .wd-state__text{display:block;color:var(--ink-soft);line-height:1.7;font-size:var(--fs-small)}
  @media (max-width:820px){.wd-story-role{padding:26px 20px}.wd-aftermath__grid{grid-template-columns:1fr}}

</style>
