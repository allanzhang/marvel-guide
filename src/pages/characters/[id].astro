---
import Base from '../../layouts/Base.astro';
import { characters, eraById, posterUrl, portraitUrl, sortedMovies, sortedSeries, isSeries, linkConcepts, pageUrl, workById, charById, softenText } from '../../lib/data.mjs';

export async function getStaticPaths() {
  return characters.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const displayName = c.alias ? `${c.name} · ${c.alias}` : c.name;
const cMovies = sortedMovies.filter((m) => c.movies.includes(m.id));
const cSeries = sortedSeries.filter((s) => (c.series || []).includes(s.id));
const cWorks = [...cMovies, ...cSeries].sort((a, b) => a.year - b.year || (a.order || 0) - (b.order || 0));
const arc = c.characterArc || { stages: [], relationships: [] };
const arcStages = (arc.stages || []).map((stage) => ({ ...stage, work: workById[stage.work] })).filter((s) => s.work);
const arcRelationships = (arc.relationships || []).map((rel) => ({
  ...rel,
  character: charById[rel.with],
  works: (rel.keyWorks || []).map((id) => workById[id]).filter(Boolean),
})).filter((r) => r.character);
const isCrossUniverse = c.universe && c.universe !== 'sacred';
const universeLabel = {
  sacred: '神圣时间线',
  sony: '索尼电影宇宙',
  fox: '福克斯宇宙',
  multi: '多元宇宙',
}[c.universe] || c.universe;
const universeEn = {
  sacred: 'Sacred Timeline',
  sony: 'Sony\'s Spider-Man Universe',
  fox: 'X-Men Universe',
  multi: 'The Multiverse',
}[c.universe] || '';
---

<Base title={`${displayName} · 漫威电影世界图鉴`} description={`${displayName} 是谁、在漫威电影宇宙中的作用与完整故事线——${c.tagline || '漫威电影世界图鉴'}`}>
  <!-- 头图：左文右图（竖版肖像完整显示，不拉伸） -->
  <section class="pd-hero full-bleed">
    <div class="pd-hero__bg-gradient"></div>
    <div class="pd-hero__inner">
      <div class="pd-hero__text">
        {isCrossUniverse && <span class="pd-hero__universe">{universeLabel}{universeEn && <em class="pd-hero__universe-en"> · {universeEn}</em>}</span>}
        <h1 class="pd-hero__name">{c.name}{c.alias && <span class="pd-hero__name-alias">{c.alias}</span>}</h1>
        <p class="pd-hero__tag">{c.tagline}</p>
      </div>
      <div class="pd-hero__portrait">
        <img class="pd-hero__portrait-img" src={portraitUrl(c.id)} alt={displayName} />
      </div>
    </div>
  </section>

  <!-- 三段式 -->
  <div class="container-text pd-body">
    <section class="pd-section">
      <h2 class="pd-section__title">他是谁</h2>
      <p class="pd-section__text" set:html={linkConcepts(c.who)}></p>
    </section>

    <section class="pd-section">
      <h2 class="pd-section__title">他的作用</h2>
      <p class="pd-section__text" set:html={linkConcepts(c.role)}></p>
    </section>

    <section class="pd-section">
      <h2 class="pd-section__title">他的故事线</h2>
      <p class="pd-section__text" set:html={linkConcepts(c.storyline)}></p>
    </section>

    {arcStages.length > 0 && (
      <section class="pd-arc">
        <h2 class="pd-section__title">角色弧线</h2>
        <ol class="pd-arc__timeline">
          {arcStages.map((stage, i) => (
            <li class="pd-arc__stage">
              <div class="pd-arc__dot">{i + 1}</div>
              <div class="pd-arc__content">
                <h3 class="pd-arc__stage-title">{stage.title}</h3>
                <a class="pd-arc__work" href={pageUrl(`works/${stage.work.id}`)} set:html={softenText(stage.work.title)}></a>
                <p class="pd-arc__summary" set:html={linkConcepts(stage.summary)}></p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {arcRelationships.length > 0 && (
      <section class="pd-arc">
        <h2 class="pd-section__title">关系变化</h2>
        <div class="pd-rel__grid">
          {arcRelationships.map((rel) => (
            <article class="pd-rel">
              <div class="pd-rel__main">
                <a class="cast pd-rel__cast" href={pageUrl(`characters/${rel.with}`)} title={rel.character.alias || rel.character.name}>
                  <img src={portraitUrl(rel.with)} alt={rel.character.alias || rel.character.name} loading="lazy" />
                  <span>{rel.character.alias || rel.character.name}</span>
                </a>
                <div class="pd-rel__body">
                  <span class="pd-rel__type">{rel.type}</span>
                  <p class="pd-rel__evolution" set:html={linkConcepts(rel.evolution)}></p>
                  {rel.works.length > 0 && (
                    <div class="pd-rel__works">
                      {rel.works.map((w) => <span class="pd-rel__work" set:html={softenText(w.title.split('（')[0])}></span>)}
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- 作品列表 -->
  <section class="pd-films">
    <div class="container-wide">
      <h2 class="pd-films__title">出演作品</h2>
      <p class="pd-films__sub">按故事时序排列，点击可跳回时间线对应条目。</p>
      <div class="pd-films__grid">
        {cWorks.map((m) => (
          <a class="film" href={pageUrl(`works/${m.id}`)}>
            <div class="film__media">
              <img src={posterUrl(m.id)} alt={m.title} loading="lazy" />
            </div>
            <div class="film__info">
              <span class="film__year">{m.yearLabel}</span>
              {isSeries(m) && <span class="film__badge">剧集</span>}
              <h3 class="film__title">{m.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== 全宽头图 ===== */
  .pd-hero {
    position: relative;
    min-height: 70vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    color: #fff;
    background:
      radial-gradient(90% 120% at 15% 0%, rgba(176, 42, 30, 0.35) 0%, transparent 55%),
      linear-gradient(160deg, #16171b 0%, #2a2b31 100%);
  }
  .pd-hero__bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 11, 13, 0.55) 0%, rgba(10, 11, 13, 0.15) 60%, rgba(10, 11, 13, 0.05) 100%);
    pointer-events: none;
  }
  .pd-hero__inner {
    position: relative;
    width: 100%;
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: 72px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }
  .pd-hero__text { flex: 1; max-width: 880px; }
  .pd-hero__portrait {
    flex-shrink: 0;
    width: min(340px, 34vw);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .pd-hero__portrait-img { width: 100%; height: auto; display: block; }
  .pd-hero__universe {
    display: inline-block;
    font-size: var(--fs-tiny);
    font-weight: 600;
    letter-spacing: 2px;
    color: #fff;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.4);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 18px;
  }
  .pd-hero__name { font-size: clamp(36px, 5vw, 72px); line-height: 1.15; }
  .pd-hero__name-alias {
    display: block;
    margin-top: 10px;
    font-size: clamp(20px, 2.4vw, 34px);
    line-height: 1.3;
    font-weight: 500;
    opacity: 0.85;
  }
  .pd-hero__tag { margin-top: 14px; font-size: var(--fs-sub); opacity: 0.92; }

  /* ===== 三段式 ===== */
  .pd-body { padding-top: 64px; }
  .pd-section { margin-bottom: 48px; }
  .pd-section__title {
    font-size: 26px;
    color: var(--accent);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .pd-section__title::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1.15em;
    border-radius: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .pd-section__text {
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--ink);
  }

  /* ===== 作品列表 ===== */
  .pd-films { margin-top: 56px; }
  .pd-films__title { font-size: 26px; margin-bottom: 8px; }
  .pd-films__sub { color: var(--ink-soft); font-size: var(--fs-small); margin-bottom: 24px; }
  .pd-films__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 16px;
  }
  @media (max-width: 820px) {
    .pd-hero { min-height: auto; padding: 48px 0 0; }
    .pd-hero__inner { flex-direction: column; gap: 32px; padding: 0 20px 40px; }
    .pd-hero__text { text-align: center; }
    .pd-hero__portrait { width: min(260px, 70vw); order: -1; }
    .pd-films__grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
  }
  /* ===== 角色弧线 ===== */
  .pd-arc { margin-bottom: 48px; }
  .pd-arc__timeline { position: relative; padding-left: 8px; }
  .pd-arc__timeline::before {
    content: ''; position: absolute; left: 19px; top: 12px; bottom: 12px;
    width: 2px; background: var(--line);
  }
  .pd-arc__stage {
    position: relative; display: flex; gap: 20px; padding: 0 0 28px;
  }
  .pd-arc__stage:last-child { padding-bottom: 0; }
  .pd-arc__dot {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%;
    background: var(--accent); color: #fff; display: flex; align-items: center;
    justify-content: center; font-family: var(--font-serif); font-weight: 700;
    font-size: 15px; z-index: 1; box-shadow: 0 0 0 4px var(--paper);
  }
  .pd-arc__content { flex: 1; padding-top: 4px; }
  .pd-arc__stage-title { font-family: var(--font-serif); font-size: 20px; margin-bottom: 4px; }
  .pd-arc__work {
    display: inline-block; font-size: var(--fs-small); color: var(--accent);
    text-decoration: underline; text-underline-offset: 3px; margin-bottom: 8px;
  }
  .pd-arc__summary { font-size: var(--fs-body); line-height: 1.8; color: var(--ink-soft); }

  /* ===== 关系变化 ===== */
  .pd-rel__grid { display: grid; gap: 16px; }
  .pd-rel {
    display: block; padding: 24px; background: #fff;
    border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow); transition: border-color 0.15s, transform 0.15s;
  }
  .pd-rel:hover { border-color: rgba(176,42,30,0.45); transform: translateY(-2px); }
  .pd-rel__main { display: flex; gap: 24px; align-items: flex-start; }
  .pd-rel__cast {
    width: 168px; padding: 10px 10px 12px; flex-shrink: 0;
    box-shadow: 0 6px 18px rgba(15, 18, 22, 0.1);
  }
  .pd-rel__body { flex: 1; min-width: 0; }
  .pd-rel__type {
    display: inline-block; margin-bottom: 10px; font-size: var(--fs-tiny);
    font-weight: 600; color: var(--accent); letter-spacing: 0.06em;
    padding: 3px 12px; border-radius: 999px;
    background: rgba(176, 42, 30, 0.06); border: 1px solid rgba(176, 42, 30, 0.28);
  }
  .pd-rel__evolution { font-size: var(--fs-body); line-height: 1.8; color: var(--ink); margin-bottom: 12px; }
  .pd-rel__works { display: flex; flex-wrap: wrap; gap: 6px; }
  .pd-rel__work {
    font-size: var(--fs-tiny); padding: 3px 10px; border-radius: 999px;
    background: var(--paper); border: 1px solid var(--line); color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .pd-arc__dot { width: 34px; height: 34px; font-size: 13px; }
    .pd-arc__timeline::before { left: 16px; }
    .pd-rel { padding: 18px; }
    .pd-rel__main { flex-direction: column; align-items: center; gap: 18px; }
    .pd-rel__cast { width: 168px; }
    .pd-rel__body { text-align: left; }
  }

</style>
