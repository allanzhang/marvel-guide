---
import Base from '../../layouts/Base.astro';
import { characters, eraById, posterUrl, portraitUrl, sortedMovies, sortedSeries, isSeries, linkConcepts, pageUrl } from '../../lib/data.mjs';

export async function getStaticPaths() {
  return characters.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const displayName = c.alias ? `${c.name} · ${c.alias}` : c.name;
const cMovies = sortedMovies.filter((m) => c.movies.includes(m.id));
const cSeries = sortedSeries.filter((s) => (c.series || []).includes(s.id));
const cWorks = [...cMovies, ...cSeries].sort((a, b) => a.year - b.year || (a.order || 0) - (b.order || 0));
const isCrossUniverse = c.universe && c.universe !== 'sacred';
const universeLabel = {
  sacred: '神圣时间线',
  sony: '索尼电影宇宙',
  fox: '福克斯宇宙',
  multi: '多元宇宙',
}[c.universe] || c.universe;
const universeEn = {
  sacred: 'Sacred Timeline',
  sony: 'Sony\'s Spider-Man Universe',
  fox: 'X-Men Universe',
  multi: 'The Multiverse',
}[c.universe] || '';
---

<Base title={`${displayName} · 漫威电影世界图鉴`} description={`${displayName} 是谁、在漫威电影宇宙中的作用与完整故事线——${c.tagline || '漫威电影世界图鉴'}`}>
  <!-- 头图：左文右图（竖版肖像完整显示，不拉伸） -->
  <section class="pd-hero full-bleed">
    <div class="pd-hero__bg-gradient"></div>
    <div class="pd-hero__inner">
      <div class="pd-hero__text">
        {isCrossUniverse && <span class="pd-hero__universe">{universeLabel}{universeEn && <em class="pd-hero__universe-en"> · {universeEn}</em>}</span>}
        <h1 class="pd-hero__name">{displayName}</h1>
        <p class="pd-hero__tag">{c.tagline}</p>
      </div>
      <div class="pd-hero__portrait">
        <img class="pd-hero__portrait-img" src={portraitUrl(c.id)} alt={displayName} />
      </div>
    </div>
  </section>

  <!-- 三段式 -->
  <div class="container-text pd-body">
    <section class="pd-section">
      <h2 class="pd-section__title">他是谁</h2>
      <p class="pd-section__text" set:html={linkConcepts(c.who)}></p>
    </section>

    <section class="pd-section">
      <h2 class="pd-section__title">他的作用</h2>
      <p class="pd-section__text" set:html={linkConcepts(c.role)}></p>
    </section>

    <section class="pd-section">
      <h2 class="pd-section__title">他的故事线</h2>
      <p class="pd-section__text" set:html={linkConcepts(c.storyline)}></p>
    </section>
  </div>

  <!-- 作品列表 -->
  <section class="pd-films">
    <div class="container-wide">
      <h2 class="pd-films__title">出演作品</h2>
      <p class="pd-films__sub">按故事时序排列，点击可跳回时间线对应条目。</p>
      <div class="pd-films__grid">
        {cWorks.map((m) => (
          <a class="film" href={pageUrl(`timeline#${m.id}`)}>
            <div class="film__media">
              <img src={posterUrl(m.id)} alt={m.title} loading="lazy" />
            </div>
            <div class="film__info">
              <span class="film__year">{m.yearLabel}</span>
              {isSeries(m) && <span class="film__badge">剧集</span>}
              <h3 class="film__title">{m.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== 全宽头图 ===== */
  .pd-hero {
    position: relative;
    min-height: 70vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    color: #fff;
    background:
      radial-gradient(90% 120% at 15% 0%, rgba(176, 42, 30, 0.35) 0%, transparent 55%),
      linear-gradient(160deg, #16171b 0%, #2a2b31 100%);
  }
  .pd-hero__bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 11, 13, 0.55) 0%, rgba(10, 11, 13, 0.15) 60%, rgba(10, 11, 13, 0.05) 100%);
    pointer-events: none;
  }
  .pd-hero__inner {
    position: relative;
    width: 100%;
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: 72px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }
  .pd-hero__text { flex: 1; max-width: 640px; }
  .pd-hero__portrait {
    flex-shrink: 0;
    width: min(340px, 34vw);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .pd-hero__portrait-img { width: 100%; height: auto; display: block; }
  .pd-hero__universe {
    display: inline-block;
    font-size: var(--fs-tiny);
    font-weight: 600;
    letter-spacing: 2px;
    color: #fff;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.4);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 18px;
  }
  .pd-hero__name { font-size: clamp(40px, 6vw, 88px); line-height: 1.1; }
  .pd-hero__tag { margin-top: 14px; font-size: var(--fs-sub); opacity: 0.92; }

  /* ===== 三段式 ===== */
  .pd-body { padding-top: 72px; }
  .pd-section { margin-bottom: 56px; }
  .pd-section__title {
    font-size: var(--fs-section);
    color: var(--accent);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .pd-section__title::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1.15em;
    border-radius: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .pd-section__text {
    font-size: var(--fs-body);
    line-height: 2.1;
    color: var(--ink);
    text-align: justify;
    text-justify: inter-ideograph;
  }

  /* ===== 作品列表 ===== */
  .pd-films { margin-top: 64px; }
  .pd-films__title { font-size: var(--fs-section); margin-bottom: 8px; }
  .pd-films__sub { color: var(--ink-soft); font-size: var(--fs-small); margin-bottom: 32px; }
  .pd-films__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 22px;
  }
  .film {
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow);
    transition: transform 0.18s ease;
  }
  .film:hover { transform: translateY(-4px); }
  .film__media { aspect-ratio: 3 / 4.4; overflow: hidden; background: var(--paper); }
  .film__media img { width: 100%; height: 100%; object-fit: cover; }
  .film__info { padding: 14px 16px 18px; }
  .film__year { font-family: var(--font-serif); font-size: var(--fs-small); color: var(--accent); font-weight: 700; }
  .film__badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 1px 8px;
    margin-left: 6px;
    vertical-align: middle;
  }
  .film__title { font-family: var(--font-serif); font-size: var(--fs-sub); margin-top: 4px; line-height: 1.35; overflow-wrap: break-word; word-break: break-word; }

  @media (max-width: 820px) {
    .pd-hero { min-height: auto; padding: 48px 0 0; }
    .pd-hero__inner { flex-direction: column; gap: 32px; padding: 0 20px 40px; }
    .pd-hero__text { text-align: center; }
    .pd-hero__portrait { width: min(260px, 70vw); order: -1; }
    .pd-films__grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
  }
</style>
