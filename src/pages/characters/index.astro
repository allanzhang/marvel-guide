---
import Base from '../../layouts/Base.astro';
import { characters, groupOrder, portraitUrl, pageUrl } from '../../lib/data.mjs';

const byGroup = (gid) => characters.filter((c) => c.group === gid);
const displayName = (c) => (c.alias ? `${c.name} · ${c.alias}` : c.name);
---

<Base title="人物墙 · 漫威电影世界图鉴" description="漫威电影宇宙人物群像：从复仇者核心到反派堂，37+ 位英雄与反派的身份、作用与完整故事线，点击查看详情。">
  <section class="ch-hero container-wide">
    <p class="ch-kicker">人物群像 · CHARACTERS</p>
    <h1 class="ch-title">漫威英雄墙 <span class="en">Marvel Heroes</span></h1>
    <p class="ch-desc">从复仇者（the Avengers）核心到反派堂，认识每个在电影世界里留下印记的人物。点击任意角色，查看他的故事线。</p>
  </section>

  {
    groupOrder.map(([gid, gname, gen]) => {
      const members = byGroup(gid);
      if (members.length === 0) return null;
      return (
        <section class="group">
          <h2 class="group__title">{gname}<span class="group__en">{gen}</span><span class="group__count">{members.length}</span></h2>
          <div class="group__grid">
            {members.map((c) => (
              <a class:list={['card', { 'card--big': c.isCoreSix }]} href={pageUrl(`characters/${c.id}`)}>
                <div class="card__media">
                  <img src={portraitUrl(c.id)} alt={displayName(c)} loading="lazy" />
                </div>
                <div class="card__body">
                  <h3 class="card__name">{displayName(c)}</h3>
                  <p class="card__tag">{c.tagline}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  /* ===== 页面标题 ===== */
  .ch-hero { padding: 88px 48px 24px; }
  .ch-kicker {
    font-size: var(--fs-tiny);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .ch-title { font-size: var(--fs-hero); line-height: 1.1; }
  .ch-title .en { font-size: 0.5em; letter-spacing: 2px; color: var(--ink-soft); font-weight: 600; display: block; margin-top: 8px; }
  .ch-desc { margin-top: 20px; color: var(--ink-soft); max-width: 640px; font-size: var(--fs-sub); }

  /* ===== 分组 ===== */
  .group { margin-top: 88px; }
  .group__title {
    font-size: var(--fs-section);
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 36px;
  }
  .group__count {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--ink-soft);
    font-weight: 400;
  }
  .group__en { font-size: 0.5em; color: var(--ink-soft); letter-spacing: 1.5px; font-weight: 600; }
  .group__title .group__en { margin-right: 2px; }

  /* ===== 网格 ===== */
  .group__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 22px;
  }

  /* ===== 卡片 ===== */
  .card {
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    display: flex;
    flex-direction: column;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12); }
  .card__media { aspect-ratio: 3 / 3.6; overflow: hidden; background: var(--paper); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; }
  .card__body { padding: 16px 18px 20px; }
  .card__name { font-family: var(--font-serif); font-size: var(--fs-sub); line-height: 1.35; overflow-wrap: break-word; word-break: break-word; }
  .card__tag { margin-top: 6px; color: var(--ink-soft); font-size: var(--fs-tiny); line-height: 1.5; }

  /* ===== 核心六人大卡（双倍） ===== */
  .card--big { grid-column: span 2; grid-row: span 2; }
  .card--big .card__body { padding: 22px 26px 28px; }
  .card--big .card__name { font-size: var(--fs-section); }
  .card--big .card__tag { font-size: var(--fs-small); }

  /* ===== 移动端 ===== */
  @media (max-width: 820px) {
    .ch-hero { padding: 56px 20px 16px; }
    .group__grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px; }
    .card--big { grid-column: span 2; grid-row: span 2; }
    .card__body { padding: 12px 14px 16px; }
    .card__name { font-size: var(--fs-small); }
    .card__tag { font-size: var(--fs-tiny); }
  }
</style>
