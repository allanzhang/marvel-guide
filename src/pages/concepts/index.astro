---
import Base from '../../layouts/Base.astro';
import { concepts, conceptOrder, pageUrl, backdropUrl } from '../../lib/data.mjs';

const byCat = (cat) => concepts.filter((c) => c.category === cat);
---

<Base title="概念库 · 漫威电影世界图鉴" description="漫威电影宇宙核心概念词条：无限宝石、魔法体系、神秘组织、地点领域与重要事件，帮你读懂剧情里的设定名词。">
  <section class="cg-hero container-wide">
    <p class="cg-kicker">图鉴词条 · LORE</p>
    <h1 class="cg-title">概念库 <span class="en">Concepts & Lore</span></h1>
    <p class="cg-desc">无限宝石、魔法体系、神秘组织、宇宙领域——看懂剧情前，先弄懂这些设定名词。</p>
  </section>

  {
    conceptOrder.map(([cat, cname, cen]) => {
      const members = byCat(cat);
      if (members.length === 0) return null;
      return (
        <section class="cgroup container-wide">
          <h2 class="cgroup__title">{cname}<span class="cgroup__en">{cen}</span><span class="cgroup__count">{members.length}</span></h2>
          <div class="cgroup__grid">
            {members.map((c) => (
              <a class="ccard" href={pageUrl(`concepts/${c.id}`)}>
                <div class="ccard__media">
                  <img src={backdropUrl(c.id)} alt={c.name} loading="lazy" />
                </div>
                <div class="ccard__body">
                  <h3 class="ccard__name">{c.name}</h3>
                  <p class="ccard__summary">{c.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .cg-hero { padding: 88px 48px 24px; }
  .cg-kicker {
    font-size: var(--fs-tiny);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .cg-title { font-size: var(--fs-hero); line-height: 1.1; }
  .cg-title .en { font-size: 0.5em; letter-spacing: 2px; color: var(--ink-soft); font-weight: 600; display: block; margin-top: 8px; }
  .cg-desc { margin-top: 20px; color: var(--ink-soft); max-width: 640px; font-size: var(--fs-sub); }

  .cgroup { margin-top: 88px; }
  .cgroup__title {
    font-size: var(--fs-section);
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 36px;
  }
  .cgroup__en { font-size: 0.5em; color: var(--ink-soft); letter-spacing: 1.5px; font-weight: 600; }
  .cgroup__count {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--ink-soft);
    font-weight: 400;
  }

  .cgroup__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }
  .ccard {
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    display: flex;
    flex-direction: column;
  }
  .ccard:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12); border-color: var(--accent); }
  .ccard__media {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--paper);
  }
  .ccard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .ccard:hover .ccard__media img { transform: scale(1.05); }
  .ccard__body { padding: 14px 16px 18px; }
  .ccard__name { font-family: var(--font-serif); font-size: 15px; font-weight: 600; line-height: 1.4; overflow-wrap: break-word; word-break: break-word; }
  .ccard__summary { margin-top: 4px; color: var(--ink-soft); font-size: var(--fs-tiny); line-height: 1.6; }

  @media (max-width: 820px) {
    .cg-hero { padding: 56px 20px 16px; }
    .cgroup__grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px; }
  }
</style>
