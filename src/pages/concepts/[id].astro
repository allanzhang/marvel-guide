---
import Base from '../../layouts/Base.astro';
import { concepts, conceptById, charById, workById, linkConcepts, backdropUrl, pageUrl } from '../../lib/data.mjs';

export async function getStaticPaths() {
  return concepts.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const relatedConcepts = (c.related || []).map((id) => conceptById[id]).filter(Boolean);
const relatedChars = (c.relatedChars || []).map((id) => charById[id]).filter(Boolean);
const appearances = (c.appearances || []).map((id) => workById[id]).filter(Boolean);
const narrative = c.narrativeRole;
const narrativeChars = (narrative?.relatedCharacters || []).map((id) => charById[id]).filter(Boolean);
const firstAppearanceWork = narrative ? workById[narrative.firstAppearance] : null;
const cBackdrop = backdropUrl(c.id);
---

<Base title={`${c.name} · 漫威概念库`} description={`${c.summary}——${c.name}的来源、背景与在漫威电影宇宙中的出现。`}>
  <section class="cd-hero full-bleed">
    <img class="cd-hero__bg" src={cBackdrop} alt="" aria-hidden="true" />
    <div class="cd-hero__shade"></div>
    <div class="cd-hero__inner">
      <p class="cd-hero__kicker">概念词条 · LORE</p>
      <h1 class="cd-hero__name">{c.name}</h1>
      <p class="cd-hero__summary">{c.summary}</p>
    </div>
  </section>

  <div class="container-text cd-body">
    <section class="cd-section">
      <h2 class="cd-section__title">它是什么</h2>
      <p class="cd-section__text" set:html={linkConcepts(c.definition)}></p>
    </section>

    <section class="cd-section">
      <h2 class="cd-section__title">来源与背景</h2>
      <p class="cd-section__text" set:html={linkConcepts(c.origin)}></p>
    </section>

    {narrative && (
      <section class="cd-section cd-narrative">
        <h2 class="cd-section__title">剧情作用</h2>
        <p class="cd-section__text cd-narrative__impact" set:html={linkConcepts(narrative.mainImpact)}></p>
        <div class="cd-narrative__grid">
          <div>
            <b>第一次推动剧情</b>
            {firstAppearanceWork && <a href={pageUrl(`works/${firstAppearanceWork.id}`)} set:html={firstAppearanceWork.title}></a>}
          </div>
          <div>
            <b>当前状态</b>
            <p set:html={linkConcepts(narrative.currentStatus)}></p>
          </div>
        </div>
        <div class="cd-narrative__moments">
          <b>关键节点</b>
          <ul>
            {narrative.keyMoments.map((item) => <li set:html={linkConcepts(item)}></li>)}
          </ul>
        </div>
        {narrativeChars.length > 0 && (
          <div class="cd-narrative__chars">
            <b>相关人物</b>
            <div>
              {narrativeChars.map((character) => <a href={pageUrl(`characters/${character.id}`)}>{character.alias || character.name}</a>)}
            </div>
          </div>
        )}
      </section>
    )}
  </div>

  {appearances.length > 0 && (
    <section class="cd-works">
      <div class="container-wide">
        <h2 class="cd-works__title">出现在</h2>
        <div class="cd-works__chips">
          {appearances.map((w) => (
            <a class="chip" href={pageUrl(`works/${w.id}`)}>{w.title}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  {(relatedConcepts.length > 0 || relatedChars.length > 0) && (
    <section class="cd-related">
      <div class="container-wide">
        <h2 class="cd-related__title">相关词条</h2>
        <div class="cd-related__grid">
          {relatedConcepts.map((r) => (
            <a class="rlink" href={pageUrl(`concepts/${r.id}`)}>
              <span class="rlink__tag">概念</span>{r.name}
            </a>
          ))}
          {relatedChars.map((r) => (
            <a class="rlink" href={pageUrl(`characters/${r.id}`)}>
              <span class="rlink__tag">人物</span>{r.alias || r.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .cd-hero {
    position: relative;
    height: 52vh;
    min-height: 380px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: #fff;
    background:
      radial-gradient(90% 80% at 85% 10%, rgba(176, 42, 30, 0.3) 0%, transparent 55%),
      linear-gradient(160deg, #1b1c1f 0%, #2f2f38 100%);
  }
  .cd-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    opacity: 0.6;
  }
  .cd-hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.65) 100%); }
  .cd-hero__inner { position: relative; width: 100%; max-width: var(--w-wide); margin: 0 auto; padding: 0 48px 56px; }
  .cd-hero__kicker {
    font-size: var(--fs-tiny);
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    margin-bottom: 14px;
  }
  .cd-hero__name { font-size: clamp(36px, 5vw, 72px); line-height: 1.15; }
  .cd-hero__summary { margin-top: 14px; font-size: var(--fs-sub); opacity: 0.9; max-width: 640px; }

  .cd-body { padding-top: 64px; }
  .cd-section { margin-bottom: 48px; }
  .cd-section__title { font-size: var(--fs-section); color: var(--accent); margin-bottom: 14px; }
  .cd-section__text { font-size: var(--fs-body); line-height: 2.1; color: var(--ink); }

  .cd-works { margin-top: 48px; }
  .cd-works__title { font-size: var(--fs-section); margin-bottom: 8px; }
  .cd-works__chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .chip {
    font-size: var(--fs-small);
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
    background: #fff;
    transition: border-color 0.15s, color 0.15s;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }

  .cd-related { margin-top: 56px; }
  .cd-related__title { font-size: var(--fs-section); margin-bottom: 20px; }
  .cd-related__grid { display: flex; flex-wrap: wrap; gap: 12px; }
  .rlink {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    transition: border-color 0.15s, color 0.15s;
  }
  .rlink:hover { border-color: var(--accent); color: var(--accent); }
  .rlink__tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 6px;
  }

  @media (max-width: 820px) {
    .cd-hero { height: 44vh; }
    .cd-hero__inner { padding: 0 20px 36px; }
  }
  .cd-narrative{padding:28px;border-radius:var(--radius);background:#fff;border:1px solid var(--line);box-shadow:var(--shadow)}
  .cd-narrative__impact{font-size:18px}
  .cd-narrative__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:24px}
  .cd-narrative b{display:block;margin-bottom:8px;color:var(--ink-soft);font-size:var(--fs-small);letter-spacing:.08em}
  .cd-narrative a{display:inline-block;color:var(--accent);font-weight:700;text-decoration:underline;text-underline-offset:3px}
  .cd-narrative p{color:var(--ink);line-height:1.8}
  .cd-narrative__moments{margin-top:24px}
  .cd-narrative__moments ul{display:grid;gap:10px;list-style:none;margin-top:10px}
  .cd-narrative__moments li{position:relative;padding-left:20px;line-height:1.85}
  .cd-narrative__moments li::before{content:'';position:absolute;left:0;top:.8em;width:7px;height:7px;border-radius:50%;background:var(--accent)}
  .cd-narrative__chars{margin-top:24px}
  .cd-narrative__chars div{display:flex;gap:10px;flex-wrap:wrap}
  .cd-narrative__chars a{padding:7px 13px;border:1px solid var(--line);border-radius:999px;color:var(--ink);text-decoration:none;font-size:var(--fs-small);font-weight:400}
  .cd-narrative__chars a:hover{border-color:var(--accent);color:var(--accent)}
  @media (max-width:820px){.cd-narrative{padding:22px 18px}.cd-narrative__grid{grid-template-columns:1fr}}

</style>
