---
// 全站基础布局：head + 顶部导航 + 页脚
import '../styles/global.css';
const { title = '漫威电影世界图鉴', description = '把看过的 MCU 重新串起来：主线复盘、剧情时序、作品图鉴、人物弧线与概念解释。' } = Astro.props;
const path = Astro.url.pathname;
const SITE = import.meta.env.SITE || 'https://example.com';
const BASE = import.meta.env.BASE_URL || '/';
// canonical 用 origin（纯域名）+ pathname（Astro 已含 base），避免双 base
const canonical = `${Astro.url.origin}${path === '/' ? '/' : path}`;
const nav = [
  { href: `${BASE}`, label: '首页' },
  { href: `${BASE}recap`, label: '主线复盘' },
  { href: `${BASE}timeline`, label: '时间线' },
  { href: `${BASE}works`, label: '作品图鉴' },
  { href: `${BASE}characters`, label: '人物墙' },
  { href: `${BASE}concepts`, label: '概念库' },
  { href: `${BASE}faq`, label: '常见疑问' },
];
const isActive = (href) => (href === `${BASE}` ? path === `${BASE}` : path.startsWith(href));
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#b02a1e" />
  <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="漫威电影世界图鉴" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${Astro.url.origin}${BASE}og-cover.svg`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;700;900&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-nav">
    <div class="inner">
      <a class="brand" href={`${BASE}`}>漫威<em>图鉴</em></a>
      <nav class="links">
        {nav.map((n) => <a href={n.href} class:list={['', { active: isActive(n.href) }]}>{n.label}</a>)}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="inner">
      <span>漫威（Marvel）电影世界图鉴 · 主线复盘、剧情时序与人物概念索引</span>
      <span>内容整理自公开资料 · 仅供学习参考</span>
    </div>
  </footer>
</body>
</html>
